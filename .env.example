# ==============================================================================
# İŞEMRİAL — ÖRNEK ORTAM DEĞİŞKENLERİ (.env.example)
# ==============================================================================
# Bu dosya tüm ortamlar için gereken değişkenleri belgeler.
# Üretim veya staging ortamında gerçek secret'lar ASLA Git'e eklenmemelidir.
# Gizli anahtarları güvenli şekilde (CI/CD Secrets, Docker Secrets veya Vault) sağlayın.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VERİTABANI KONFİGÜRASYONU (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=isemrial_dev

# Host Portu (Yalnızca yerel geliştirme ve hata ayıklama için host'a bağlanır)
# Üretim ortamında PostgreSQL portu host'a yayınlanmaz, yalnızca Docker iç ağında kalır.
POSTGRES_PORT=5433

# Prisma & API Bağlantı Adresi
# Yerel Geliştirme (Host üzerinden): postgresql://postgres:postgres@localhost:5433/isemrial_dev?schema=public
# Docker İç Ağı (Konteyner içi):     postgresql://postgres:postgres@db:5432/isemrial_dev?schema=public
DATABASE_URL="postgresql://postgres:postgres@db:5432/isemrial_dev?schema=public"

# ------------------------------------------------------------------------------
# 2. BACKEND API KONFİGÜRASYONU (NestJS)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production

# İzin verilen Frontend kaynak adresi (CORS ve CSRF Origin doğrulaması)
# Geliştirme: http://localhost:3000
# Üretim:     https://app.isemrial.com
FRONTEND_ORIGIN="http://localhost:3000"

# Oturum İmzası ve Çerez Gizli Anahtarı (Production'da en az 32 karakter rastgele dize zorunludur)
# Örnek: openssl rand -hex 32
SESSION_SECRET="change-this-to-a-very-secure-random-secret-in-production-min-32-chars"
SESSION_MAX_AGE_DAYS=7

# Reverse Proxy Desteği (Docker, Caddy, Nginx arkasında gerçek istemci IP tespiti)
TRUST_PROXY=true

# ------------------------------------------------------------------------------
# 3. FRONTEND KONFİGÜRASYONU (Next.js Standalone)
# ------------------------------------------------------------------------------
WEB_PORT=3000

# Next.js Server-Side API Proxy Adresi (Rewrites için kullanılır)
# Docker İç Ağı: http://api:4000
# Yerel Host:   http://localhost:4000
INTERNAL_API_URL="http://api:4000"

# İstemci Tarafı API Adresi (Boş bırakıldığında aynı domain "/api" kullanılır)
NEXT_PUBLIC_API_URL=""

# Demo Giriş Kartları (Üretimde KESİNLİKLE false olmalıdır)
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="false"
